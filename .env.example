# Internal AI Process Assistant configuration

# Embedding provider options:
# - deterministic: offline test provider, no API calls
# - openai: future paid OpenAI embedding provider, opt-in only
IAPA_EMBEDDING_PROVIDER=deterministic

# Required only when IAPA_EMBEDDING_PROVIDER=openai.
# Never commit a real API key.
OPENAI_API_KEY=

# Future OpenAI embedding model candidate.
IAPA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local cost guardrails for paid embedding providers.
IAPA_MAX_EMBEDDING_CHUNKS_PER_RUN=20
IAPA_MAX_ESTIMATED_EMBEDDING_TOKENS_PER_RUN=20000

# Paid embedding API calls are disabled by default.
# Set this to true only when you intentionally want to allow paid provider calls.
IAPA_ALLOW_PAID_EMBEDDING_CALLS=false
